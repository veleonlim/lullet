{
  "name": "lullet",
  "version": "0.1.0",
  "private": true,
  "description": "Splitwise-like expense splitter for four people, first used on a trip to Switzerland and Italy.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:static": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node --env-file-if-exists=.env --env-file-if-exists=.env.production.local --import tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx scripts/seed.ts",
    "auth:bootstrap": "node --env-file-if-exists=.env --env-file-if-exists=.env.production.local --import tsx scripts/bootstrap-group.ts",
    "eval:screenshots": "node --env-file-if-exists=.env --import tsx scripts/eval-screenshots.ts",
    "auth:mint-link": "node --env-file-if-exists=.env --env-file-if-exists=.env.production.local --import tsx scripts/mint-login-link.ts",
    "telegram:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.production.local --import tsx scripts/telegram-setup.ts",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.production.local --import tsx scripts/check-env.ts",
    "export:csv": "node --env-file-if-exists=.env --env-file-if-exists=.env.production.local --import tsx scripts/export-csv.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1158.0",
    "drizzle-orm": "0.45.4",
    "grammy": "1.46.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
