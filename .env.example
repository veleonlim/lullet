# Copy to .env for local development. Never commit real secrets.

# Local Postgres from compose.yaml. In production this is Neon's POOLED connection string.
DATABASE_URL=postgres://lullet:lullet@localhost:5432/lullet
# Optional. Neon's DIRECT (non-pooled) connection string, preferred for migrations.
# DATABASE_URL_UNPOOLED=
# Optional. Max connections per server instance (default 5). Use 1 on serverless hosts.
# DATABASE_POOL_MAX=

# Development sign-in stand-in: signs everyone in as the first member created by `pnpm db:seed`.
# Local development only. It is ignored on Vercel production and preview and in production builds.
# LULLET_DEV_AUTH=1

# --- Placeholders for later slices (not read by slice 1) ---
# Telegram bot from BotFather (slice 3)
# TELEGRAM_BOT_TOKEN=
# Public origin of the app; login links are built from it. Required in production.
APP_URL=http://localhost:3000

# --- Placeholders for later slices ---
# Secret token checked on every Telegram webhook call (slice 3)
# TELEGRAM_WEBHOOK_SECRET=
# Claude Console API key for screenshot extraction (slice 4)
# ANTHROPIC_API_KEY=
# Cloudflare R2 (S3-compatible) private bucket for original screenshots (slice 4)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Shared secret for scheduled jobs such as the 30-day screenshot deletion (slice 7)
# CRON_SECRET=
