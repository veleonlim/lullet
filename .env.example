# Copy to .env for local development. Never commit real secrets.

# Local Postgres from compose.yaml. In production this is Neon's POOLED connection string.
DATABASE_URL=postgres://lullet:lullet@localhost:5432/lullet
# Optional. Neon's DIRECT (non-pooled) connection string, preferred for migrations.
# DATABASE_URL_UNPOOLED=
# Optional. Max connections per server instance (default 5). Use 1 on serverless hosts.
# DATABASE_POOL_MAX=

# --- Sign in with Telegram (read by the app) ---
# Key used to hash session cookies and login-link tokens at rest. At least 32 characters;
# generate one with `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=local-development-secret-change-me-0123456789
# Bot token from BotFather. The key material for verifying Mini App init data.
# TELEGRAM_BOT_TOKEN=
# Public origin of the app; login links are built from it. Required in production.
APP_URL=http://localhost:3000

# --- Telegram bot (see the README, section Telegram bot) ---
# Secret token Telegram sends with every webhook call (16+ characters of A-Z a-z 0-9 _ -);
# generate one with `openssl rand -hex 32`. It also keys the nonce on inline buttons.
# TELEGRAM_WEBHOOK_SECRET=
# Numeric chat id of the one group chat the bot serves (usually negative, like -1001234567890).
# TELEGRAM_GROUP_CHAT_ID=
# The bot's username without @. Optional: when unset the bot asks Telegram once.
# TELEGRAM_BOT_USERNAME=
# Test only: a fake Bot API server instead of https://api.telegram.org.
# TELEGRAM_API_ROOT=
# --- Screenshot import ---
# Claude Console API key. Read only from the environment. Without it uploads still work but every
# screenshot becomes an empty draft to fill in by hand.
# ANTHROPIC_API_KEY=
# Cloudflare R2 (S3-compatible) private bucket for original screenshots. When all four are set they
# are used; otherwise development keeps files under LULLET_STORAGE_DIR (default .data/screenshots).
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# LULLET_STORAGE_DIR=.data/screenshots
# Set to "local" to allow local-file storage in a production build (the end to end suite does).
# LULLET_STORAGE=local
# Shared secret for the scheduled clean-up at /api/cron/retention (Vercel Cron sends it as
# "Authorization: Bearer <secret>"). With no secret the route refuses every call.
# CRON_SECRET=
# Uploads per person per rolling day (default 30).
# IMPORT_DAILY_LIMIT=30
# Test only: answer from canned files instead of calling Claude (see tests/e2e).
# LULLET_EXTRACTOR=stub
# LULLET_STUB_DIR=.data/stub-extractions
